#!/usr/bin/env node

const path = require("node:path");
const { pathToFileURL } = require("node:url");

const packageJsonPath = require.resolve("@typescript/native/package.json");
const cliPath = path.join(path.dirname(packageJsonPath), "lib", "tsc.js");

import(pathToFileURL(cliPath).href).catch((error) => {
  console.error(error);
  process.exitCode = 1;
});
