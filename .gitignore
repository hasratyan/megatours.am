# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

/documentations/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-preview/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Local IDE database settings
/.idea/dataSources.xml
/.idea/db-forest-config.xml

# Generated logs, verification artifacts, and temporary files
/logs/
/output/
/tmp/

# Copied from node_modules by scripts/copy-maplibre-worker.mjs
/public/maplibre/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (allow example for sharing config)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env
.env
.env
